{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-masoudhos",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "11044f34-d504-41d3-a06e-fd930638a799","database_name": "nova-proxy" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "21e07ccd6ed54f58bee705f94c8054fa" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
